# Variáveis de Ambiente locais para a aplicação RetroGames
# Exemplo de configuração local (duplique como .env)

# String de Conexão com o MySQL local / Docker
# Formato padrão com usuário root ou usuário local conforme diretrizes:
ConnectionStrings__Default=Server=localhost;Port=3306;Database=retrogames_db;Uid=root;Pwd=SUA_SENHA;

# Credenciais do Administrador Inicial do Sistema
AdminInicial__Email=admin@retrogames.local
AdminInicial__Senha=Minecraft
